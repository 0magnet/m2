wasm/stl2/

# Old UI content backups (site-specific)
ui/content-bak/
content/clock.html
content/mementomori.html

# Site-specific stock-page overrides (repo ships *.example fallbacks)
content/about.html
content/about.txt
content/policy.html
content/links.html
content/links.txt

